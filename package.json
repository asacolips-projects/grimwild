{
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "BUILD_PACKS=1 vite build --mode production",
    "build:dev": "BUILD_PACKS=1 vite build --mode development",
    "clean": "node scripts/build/index.mjs --task=clean",
    "content:pack": "node scripts/build/index.mjs --task=compilePacks",
    "content:unpack": "node scripts/build/index.mjs --task=extractPacks",
    "symlinks:create": "node ./tools/create-symlink.mjs",
    "lint": "eslint --ext .js,.cjs,.mjs,.vue .",
    "lint:fix": "eslint --ext .js,.cjs,.mjs,.vue --fix .",
    "lint:warnings": "eslint --max-warnings 0 --ext .js,.cjs,.mjs,.vue .",
    "lint:errors": "eslint --quiet --ext .js,.cjs,.mjs,.vue .",
    "lint:fix:errors": "eslint --quiet --ext .js,.cjs,.mjs,.vue --fix ."
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.9",
    "@foundryvtt/foundryvtt-cli": "^1.0.3",
    "@stylistic/eslint-plugin-js": "^1.5.1",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "autoprefixer": "^10.4.21",
    "chokidar": "^4.0.3",
    "eslint": "^8.55.0",
    "eslint-plugin-jsdoc": "^46.9.0",
    "eslint-plugin-vue": "^9.33.0",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.6",
    "sass": "^1.89.2",
    "vite": "^5.3.4"
  },
  "dependencies": {
    "vue": "3.5.16"
  }
}

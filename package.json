{
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "BUILD_PACKS=1 vite build --mode production",
    "build:dev": "BUILD_PACKS=1 vite build --mode development",
    "clean": "node scripts/build/index.mjs --task=clean",
    "content:pack": "node scripts/build/index.mjs --task=compilePacks",
    "content:unpack": "node scripts/build/index.mjs --task=extractPacks",
    "symlinks:create": "node ./tools/create-symlink.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:warnings": "eslint --max-warnings 0 .",
    "lint:errors": "eslint --quiet .",
    "lint:fix:errors": "eslint --quiet --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundryvtt/foundryvtt-cli": "^3.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typhonjs-fvtt/eslint-config-foundry.js": "^0.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.4.21",
    "chokidar": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^11.0.4",
    "postcss": "^8.5.6",
    "sass": "^1.89.2",
    "vite": "^8.3.5",
    "vue-eslint-parser": "^10.4.1",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
